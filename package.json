{
  "name": "skyaccess-mcp",
  "mcpName": "com.skyaccess/skyaccess",
  "version": "1.0.0",
  "description": "Hosted SkyAccess MCP server for private jet empty legs: installer for Claude, Cursor and other MCP clients, plus a stdio bridge.",
  "license": "MIT",
  "author": "SkyAccess Inc.",
  "type": "module",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "skyaccess-mcp": "bin/skyaccess-mcp.mjs"
  },
  "exports": {
    ".": "./src/cli.mjs"
  },
  "files": [
    "bin",
    "src",
    "!src/__tests__",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "claude",
    "cursor",
    "private-jet",
    "charter",
    "empty-legs",
    "skyaccess"
  ],
  "homepage": "https://skyaccess.com",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:live": "SKYACCESS_MCP_LIVE=1 vitest run",
    "doctor": "node ./bin/skyaccess-mcp.mjs doctor"
  },
  "devDependencies": {
    "vitest": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sky-access/skyaccess-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/sky-access/skyaccess-mcp/issues"
  }
}
