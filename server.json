{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.skyaccess/skyaccess",
  "title": "SkyAccess",
  "description": "Search 5,000+ live empty leg flights, get charter estimates and booking links. Free, no API key.",
  "version": "1.0.3",
  "websiteUrl": "https://skyaccess.com",
  "repository": {
    "url": "https://github.com/sky-access/skyaccess-mcp",
    "source": "github",
    "id": "1350713226"
  },
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/sky-access/skyaccess-mcp/main/assets/icon.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.skyaccess.com/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "skyaccess-mcp",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "npx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "bridge"
        }
      ]
    }
  ]
}
